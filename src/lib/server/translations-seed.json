  { "key": "about.hero.eyebrow", "vi": "About iWood · Since 2019", "en": "About iWood · Since 2019" },
  { "key": "about.hero.heading", "vi": "Vật liệu kiến trúc\ncho người Việt.", "en": "Architectural materials\nfor Vietnamese people." },
  { "key": "about.hero.lead", "vi": "7 năm — 1.200+ dự án — 12.000m² nhà xưởng. iWood là nhà sản xuất trực tiếp tấm ốp than tre, PVC nano, SPC đá và lam sóng tại Việt Nam.", "en": "7 years — 1,200+ projects — 12,000m² factory. iWood is a direct manufacturer of bamboo charcoal panels, PVC nano, SPC stone and wave slats in Vietnam." },
  { "key": "about.mission.eyebrow", "vi": "Sứ mệnh · Our mission", "en": "Our mission · Sứ mệnh" },
  { "key": "about.mission.heading", "vi": "Vật liệu tốt — giá thật — bảo hành thật.", "en": "Good materials — real price — real warranty." },
  { "key": "about.mission.lead", "vi": "Chúng tôi tin rằng vật liệu nội thất chất lượng không nên là đặc quyền. Với mô hình sản xuất trực tiếp, không qua trung gian, iWood mang đến cho khách hàng Việt mức giá xưởng và bảo hành 5 năm chính hãng.", "en": "We believe quality interior materials should not be a privilege. With a direct manufacturing model, no middlemen, iWood brings Vietnamese customers factory prices and a 5-year genuine warranty." },
  { "key": "about.mission.body", "vi": "Mỗi tấm ốp ra khỏi nhà máy đều được kiểm định Quatest 3, đóng dấu mã sản xuất và thông tin bảo hành. Khi có vấn đề, khách hàng liên hệ trực tiếp nhà sản xuất — không qua đại lý, không vòng vo.", "en": "Every panel leaving the factory is inspected by Quatest 3, stamped with production code and warranty information. When issues arise, customers contact the manufacturer directly — no agents, no runaround." },
  { "key": "about.timeline.eyebrow", "vi": "Hành trình · Timeline", "en": "Our journey · Timeline" },
  { "key": "about.timeline.heading", "vi": "7 năm xây nền móng", "en": "7 years building the foundation" },
  { "key": "about.timeline.2019.title", "vi": "Thành lập", "en": "Founded" },
  { "key": "about.timeline.2019.body", "vi": "iWood ra đời tại Bình Dương — xưởng đầu tiên 1.500m².", "en": "iWood was born in Binh Duong — first factory 1,500m²." },
  { "key": "about.timeline.2021.title", "vi": "ISO 9001", "en": "ISO 9001" },
  { "key": "about.timeline.2021.body", "vi": "Đạt chứng nhận ISO 9001 — hệ thống quản lý chất lượng.", "en": "Achieved ISO 9001 certification — quality management system." },
  { "key": "about.timeline.2023.title", "vi": "Mở rộng", "en": "Expansion" },
  { "key": "about.timeline.2023.body", "vi": "Showroom Hà Nội + Đà Nẵng. Nhà xưởng mở rộng 12.000m².", "en": "Hanoi + Da Nang showrooms. Factory expanded to 12,000m²." },
  { "key": "about.timeline.2026.title", "vi": "Thế hệ mới", "en": "Next generation" },
  { "key": "about.timeline.2026.body", "vi": "Ra mắt dòng SPC đá Premium và lam sóng Walnut Series.", "en": "Launched Premium SPC stone line and Walnut Series wave slats." },
