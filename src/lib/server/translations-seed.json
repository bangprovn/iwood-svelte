  { "key": "about.values.award.body", "vi": "ISO 9001 + Quatest 3. Mỗi lô sản xuất có giấy kiểm định.", "en": "ISO 9001 + Quatest 3. Every production batch has inspection papers." },
  { "key": "about.values.truck.title", "vi": "Giao hàng toàn quốc", "en": "Nationwide delivery" },
