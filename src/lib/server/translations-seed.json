  { "key": "product.install_heading", "vi": "Quy trình thi công 5 bước", "en": "5-step installation process" },
  { "key": "product.install_step_1", "vi": "Chuẩn bị bề mặt: đảm bảo phẳng, sạch và khô. Trám phẳng các khe hở > 2mm.", "en": "Prepare surface: ensure flat, clean and dry. Fill gaps > 2mm." },
  { "key": "product.install_step_2", "vi": "Đo và chia khoảng: tính toán điểm bắt đầu để cân đối tấm hai bên.", "en": "Measure and divide spacing: calculate starting point for balanced panels." },
  { "key": "product.install_step_3", "vi": "Bôi keo: keo PU chuyên dụng, đường zigzag cách 15cm.", "en": "Apply adhesive: specialized PU adhesive, zigzag pattern every 15cm." },
  { "key": "product.install_step_4", "vi": "Ghép tấm: từ trái qua phải, ghép âm dương khít.", "en": "Fit panels: left to right, tight tongue-and-groove fit." },
  { "key": "product.install_step_5", "vi": "Hoàn thiện: lắp phào nẹp kết thúc, vệ sinh bề mặt.", "en": "Finish: install trim and moldings, clean surface." },
  { "key": "product.warranty_heading", "vi": "Chính sách bảo hành", "en": "Warranty policy" },
  { "key": "product.warranty_body", "vi": "iWood bảo hành 60 tháng (5 năm) cho mọi lỗi sản xuất: bong tróc bề mặt, phồng rộp, cong vênh do lõi.", "en": "iWood warrants 60 months (5 years) for all manufacturing defects: surface peeling, blistering, core warping." },
  { "key": "product.warranty_process", "vi": "Khi cần bảo hành, khách hàng liên hệ trực tiếp hotline 0915 000 000 hoặc showroom gần nhất. Đội kỹ thuật iWood sẽ kiểm tra trong 48h và xử lý miễn phí nếu lỗi do nhà sản xuất.", "en": "For warranty claims, customers contact hotline 0915 000 000 or the nearest showroom. The iWood technical team will inspect within 48h and fix free of charge if it's a manufacturer defect." },
