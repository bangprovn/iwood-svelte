  { "key": "about.values.shield.en", "vi": "True warranty", "en": "True warranty" },
  { "key": "about.values.shield.body", "vi": "5 năm bảo hành chính hãng. Liên hệ thẳng nhà sản xuất, không qua đại lý.", "en": "5-year genuine warranty. Contact the manufacturer directly, no agents." },
  { "key": "about.values.award.title", "vi": "Chất lượng kiểm định", "en": "Certified quality" },
